# Copy this file to .env and fill in the password.
# .env is git-ignored — never commit your real password.

# Gmail account that sends the contact-form emails
GMAIL_USER=adityaparihar914@gmail.com

# 16-character Google App Password (NOT your normal Gmail password).
# Create one at https://myaccount.google.com/apppasswords (needs 2-Step Verification on).
GMAIL_APP_PASSWORD=

# Optional: deliver messages to a different inbox (defaults to GMAIL_USER)
CONTACT_TO=
